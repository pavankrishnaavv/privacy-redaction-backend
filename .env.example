# Privacy Redaction Engine Configuration
# Plate Recognizer API Credentials (https://guides.platerecognizer.com)
PLATE_RECOGNIZER_TOKEN=your_plate_recognizer_api_key_here
PLATE_RECOGNIZER_ENDPOINT=https://api.platerecognizer.com/v1/plate-reader/

# Face++ Detection API Credentials (https://console.faceplusplus.com/documents/7078057)
FACEPLUSPLUS_API_KEY=your_faceplusplus_api_key_here
FACEPLUSPLUS_API_SECRET=your_faceplusplus_api_secret_here
FACEPLUSPLUS_ENDPOINT=https://api-us.faceplusplus.com/facepp/v3/detect

# Redaction Parameters
DEFAULT_BLUR_RADIUS=25
EXPAND_MARGIN_PERCENT=0.12
FEATHER_EDGES=true
STRIP_EXIF=true

# Server Configuration
PORT=8002
HOST=0.0.0.0
CORS_ORIGINS=*
